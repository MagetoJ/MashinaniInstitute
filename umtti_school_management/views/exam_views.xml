<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Grade bands ============ -->
    <record id="view_umtti_grade_band_tree" model="ir.ui.view">
        <field name="name">umtti.grade.band.tree</field>
        <field name="model">umtti.grade.band</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="min_percent"/>
                <field name="name"/>
                <field name="code"/>
                <field name="competent"/>
            </list>
        </field>
    </record>
    <record id="action_umtti_grade_band" model="ir.actions.act_window">
        <field name="name">Grading Scale</field>
        <field name="res_model">umtti.grade.band</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ============ Rubrics ============ -->
    <record id="view_umtti_rubric_form" model="ir.ui.view">
        <field name="name">umtti.rubric.form</field>
        <field name="model">umtti.rubric</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="total_points"/>
                    </group>
                    <field name="criterion_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="descriptor"/>
                            <field name="max_points" sum="Total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_umtti_rubric_tree" model="ir.ui.view">
        <field name="name">umtti.rubric.tree</field>
        <field name="model">umtti.rubric</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="total_points"/>
            </list>
        </field>
    </record>
    <record id="action_umtti_rubric" model="ir.actions.act_window">
        <field name="name">Rubrics</field>
        <field name="res_model">umtti.rubric</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ Assessments ============ -->
    <record id="view_umtti_assessment_tree" model="ir.ui.view">
        <field name="name">umtti.assessment.tree</field>
        <field name="model">umtti.assessment</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="assessment_type"/>
                <field name="class_id"/>
                <field name="unit_id"/>
                <field name="trainer_id"/>
                <field name="average_percent"/>
                <field name="pass_rate"/>
                <field name="state" widget="badge" decoration-info="state == 'marking'"
                       decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>
    <record id="view_umtti_assessment_form" model="ir.ui.view">
        <field name="name">umtti.assessment.form</field>
        <field name="model">umtti.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_students" string="Load Students" type="object" class="btn-primary"
                            invisible="state == 'published'"/>
                    <button name="action_publish" string="Publish Results" type="object"
                            invisible="state != 'marking'"/>
                    <button name="action_reset" string="Reopen" type="object" invisible="state != 'published'"
                            groups="umtti_school_management.group_umtti_user"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state == 'published'"/>
                            <field name="assessment_type" readonly="state == 'published'"/>
                            <field name="class_id" readonly="state != 'draft'"/>
                            <field name="course_id"/>
                            <field name="unit_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="trainer_id" readonly="state == 'published'"/>
                            <field name="date" readonly="state == 'published'"/>
                            <field name="max_marks" readonly="state != 'draft'"/>
                            <field name="weight" readonly="state == 'published'"/>
                            <field name="rubric_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="average_percent"/>
                        <field name="pass_rate"/>
                    </group>
                    <field name="result_ids" readonly="state == 'published'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="student_id" readonly="1"/>
                            <field name="absent"/>
                            <field name="marks" readonly="parent.rubric_id"/>
                            <field name="percentage"/>
                            <field name="grade_id"/>
                            <field name="competent" widget="boolean"/>
                            <field name="remarks"/>
                            <button name="action_open_scores" type="object" icon="fa-list-alt" title="Rubric scores"
                                    invisible="not parent.rubric_id"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_umtti_assessment_search" model="ir.ui.view">
        <field name="name">umtti.assessment.search</field>
        <field name="model">umtti.assessment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="class_id"/>
                <field name="unit_id"/>
                <field name="trainer_id"/>
                <filter name="formative" string="Formative" domain="[('assessment_type', '=', 'formative')]"/>
                <filter name="summative" string="Summative" domain="[('assessment_type', '=', 'summative')]"/>
                <filter name="marking" string="Being Marked" domain="[('state', '=', 'marking')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_class" string="Class" context="{'group_by': 'class_id'}"/>
                    <filter name="group_unit" string="Unit" context="{'group_by': 'unit_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'assessment_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_umtti_assessment" model="ir.actions.act_window">
        <field name="name">Assessments &amp; Exams</field>
        <field name="res_model">umtti.assessment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Rubric scoring dialog (opened from a result row) -->
    <record id="view_umtti_result_form" model="ir.ui.view">
        <field name="name">umtti.assessment.result.form</field>
        <field name="model">umtti.assessment.result</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" readonly="1"/>
                            <field name="assessment_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="marks" readonly="1"/>
                            <field name="percentage"/>
                            <field name="grade_id"/>
                        </group>
                    </group>
                    <field name="score_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="criterion_id" readonly="1"/>
                            <field name="max_points"/>
                            <field name="score"/>
                        </list>
                    </field>
                    <field name="remarks" placeholder="Remarks..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Results analysis -->
    <record id="view_umtti_result_tree" model="ir.ui.view">
        <field name="name">umtti.assessment.result.tree</field>
        <field name="model">umtti.assessment.result</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="assessment_id"/>
                <field name="class_id"/>
                <field name="unit_id"/>
                <field name="student_id"/>
                <field name="marks"/>
                <field name="percentage"/>
                <field name="grade_id"/>
                <field name="competent" widget="boolean"/>
            </list>
        </field>
    </record>
    <record id="view_umtti_result_pivot" model="ir.ui.view">
        <field name="name">umtti.assessment.result.pivot</field>
        <field name="model">umtti.assessment.result</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="student_id" type="row"/>
                <field name="unit_id" type="col"/>
                <field name="percentage" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_umtti_result_search" model="ir.ui.view">
        <field name="name">umtti.assessment.result.search</field>
        <field name="model">umtti.assessment.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="unit_id"/>
                <filter name="published" string="Published" domain="[('assessment_state', '=', 'published')]"/>
                <filter name="nyc" string="Not Yet Competent" domain="[('competent', '=', False), ('absent', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_class" string="Class" context="{'group_by': 'class_id'}"/>
                    <filter name="group_unit" string="Unit" context="{'group_by': 'unit_id'}"/>
                    <filter name="group_grade" string="Grade" context="{'group_by': 'grade_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_umtti_result" model="ir.actions.act_window">
        <field name="name">Results Analysis</field>
        <field name="res_model">umtti.assessment.result</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_published': 1}</field>
    </record>

    <!-- Student form: results, PoE and tools -->
    <record id="view_partner_form_umtti_exam" model="ir.ui.view">
        <field name="name">res.partner.form.umtti.exam</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Results &amp; Portfolio" name="umtti_results" invisible="not is_student">
                    <separator string="Assessment Results"/>
                    <field name="result_ids" readonly="1">
                        <list>
                            <field name="assessment_id"/>
                            <field name="unit_id"/>
                            <field name="marks"/>
                            <field name="percentage"/>
                            <field name="grade_id"/>
                            <field name="assessment_state"/>
                        </list>
                    </field>
                    <separator string="Portfolios of Evidence"/>
                    <field name="poe_ids" readonly="1">
                        <list>
                            <field name="unit_id"/>
                            <field name="entry_count"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="state"/>
                        </list>
                    </field>
                    <separator string="Tools &amp; Equipment Issued"/>
                    <field name="tool_issue_ids" readonly="1">
                        <list>
                            <field name="tool"/>
                            <field name="serial_no"/>
                            <field name="purpose"/>
                            <field name="date_issued"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
