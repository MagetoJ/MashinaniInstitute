<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_umtti_trainer" model="ir.ui.view">
        <field name="name">hr.employee.form.umtti.trainer</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Trainer Details" name="umtti_trainer">
                    <group>
                        <group>
                            <field name="is_trainer"/>
                            <field name="tivet_no" invisible="not is_trainer"/>
                            <field name="kra_pin" invisible="not is_trainer"/>
                            <field name="contract_type" invisible="not is_trainer"/>
                        </group>
                        <group invisible="not is_trainer">
                            <field name="qualification"/>
                            <field name="qualification_details"/>
                            <field name="weekly_hours" widget="float_time"/>
                        </group>
                    </group>
                    <field name="course_ids" widget="many2many_tags" invisible="not is_trainer"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_employee_search_umtti_trainer" model="ir.ui.view">
        <field name="name">hr.employee.search.umtti.trainer</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="trainers" string="Trainers" domain="[('is_trainer', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_umtti_trainer" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_trainer', '=', True)]</field>
        <field name="context">{'default_is_trainer': True}</field>
    </record>
</odoo>
